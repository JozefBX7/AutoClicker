<Window x:Class="AutoClicker.HotkeyLightingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoClicker"
        Title="Hotkey lighting" Width="390" Height="330" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="14"><Grid Margin="1"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="13,13,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid Margin="20,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="Hotkey lighting" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"/><TextBlock x:Name="HintLabel" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel><Button Content="×" Click="CloseButton_Click" ToolTip="Close" Style="{StaticResource CloseButton}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
        <StackPanel Grid.Row="1" Margin="20,16"><CheckBox x:Name="EnabledCheckBox" Content="Light this hotkey while it is active" FontWeight="SemiBold"/><TextBlock Text="This override keeps the keyboard selected in Settings and only changes this hotkey’s lighting." Style="{StaticResource SectionHint}" Margin="0,3,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Colour" Style="{StaticResource FieldLabel}"/><Button x:Name="ColourButton" Click="ColourButton_Click" Style="{StaticResource GhostButton}" Width="102" Padding="5"><StackPanel Orientation="Horizontal"><Border x:Name="ColourPreview" Width="18" Height="18" CornerRadius="3" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"/><TextBlock x:Name="ColourLabel" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="10"/></StackPanel></Button></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Effect" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="EffectCombo" SelectionChanged="EffectCombo_SelectionChanged"><ComboBoxItem Content="{x:Static local:RgbLightingEffectIds.Constant}"/><ComboBoxItem Content="{x:Static local:RgbLightingEffectIds.Blink}"/><ComboBoxItem Content="{x:Static local:RgbLightingEffectDisplayNames.Pulse}"/></ComboBox></StackPanel></Grid><StackPanel x:Name="SpeedPanel" Margin="0,15,0,0"><Grid><TextBlock Text="Effect speed" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="SpeedLabel" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccentBrush}" FontSize="10"/></Grid><Slider x:Name="SpeedSlider" Minimum="0" Maximum="100" ValueChanged="SpeedSlider_ValueChanged" Style="{StaticResource EffectSpeedSlider}"/><TextBlock x:Name="SpeedHint" Style="{StaticResource SectionHint}"/></StackPanel></StackPanel>
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,13,13" Padding="20,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="CloseButton_Click" Style="{StaticResource GhostButton}"/><Button Content="Save override" Click="SaveButton_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/></StackPanel></Border>
    </Grid></Border>
</Window>
