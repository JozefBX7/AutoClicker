<Window x:Class="AutoClicker.SequenceRecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoClicker"
        Title="Record sequence" AutomationProperties.AutomationId="{x:Static local:SequenceRecorderAutomationIds.Window}"
        Icon="/AutoClicker;component/Assets/AutoClickerIcon.ico" Width="460" Height="470" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing" PreviewMouseDown="Window_PreviewMouseDown" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid Margin="1">
            <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="13,13,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Record sequence" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"/><TextBlock Text="Capture keyboard, mouse buttons, and scrolling." FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel>
                    <Button Click="CancelButton_Click" ToolTip="Close recorder" Style="{StaticResource CloseButton}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"><Viewbox Width="12" Height="12"><Path Data="M 2 2 L 10 10 M 10 2 L 2 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"/></Viewbox></Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="20,16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="13,11">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Ellipse x:Name="RecordingIndicator" Width="10" Height="10" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock x:Name="StatusLabel" AutomationProperties.AutomationId="{x:Static local:SequenceRecorderAutomationIds.Status}" Text="Ready to record" FontWeight="SemiBold"/><TextBlock x:Name="DetailLabel" Text="Press Start, then use the keyboard or mouse anywhere." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel>
                        <TextBlock x:Name="EventCountLabel" Grid.Column="2" AutomationProperties.AutomationId="{x:Static local:SequenceRecorderAutomationIds.EventCount}" Text="No events" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="2,14,0,0">
                    <CheckBox x:Name="IncludeDelaysCheckBox" AutomationProperties.AutomationId="{x:Static local:SequenceRecorderAutomationIds.IncludeDelays}" Content="Include delays between inputs" IsChecked="True" FontWeight="SemiBold"/>
                    <CheckBox x:Name="TreatBriefTapsAsPressesCheckBox" AutomationProperties.AutomationId="{x:Static local:SequenceRecorderAutomationIds.TreatBriefTapsAsPresses}" Content="Treat brief inputs as presses instead of short holds" IsChecked="False" FontWeight="SemiBold" Margin="0,7,0,0" ToolTip="Converts an isolated keyboard or mouse-button down/up lasting 160 ms or less into one Press event. Chords remain Hold and Release events."/>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Keyboard auto-repeat, generated input, and recorder-control clicks are ignored. Stopping closes any input that is still held." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="2,7,0,0"/>
                <Border x:Name="RecordedEventsPanel" Grid.Row="3" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Recorded events" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"/>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <ListBox x:Name="RecordedEventsList" AutomationProperties.AutomationId="{x:Static local:SequenceRecorderAutomationIds.RecordedEvents}" SelectionMode="Extended" HorizontalContentAlignment="Stretch" PreviewMouseLeftButtonDown="RecordedEventsList_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="RecordedEventsList_PreviewMouseLeftButtonUp" PreviewMouseRightButtonUp="RecordedEventsList_PreviewMouseRightButtonUp">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Label}"/></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate><Grid Margin="1,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" AutomationProperties.AutomationId="{x:Static local:SequenceRecorderAutomationIds.DeleteRecordedEvent}" Tag="{Binding Step}" Click="DeleteRecordedEvent_Click" ToolTip="Delete this recorded event" Style="{StaticResource DangerButton}" Visibility="{Binding DeleteButtonVisibility}" Width="26" Height="24" MinWidth="0" MinHeight="0" Padding="5" Margin="6,0,4,0"><Viewbox Width="11" Height="11"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M 7 3 L 17 3 L 16 20 L 8 20 Z M 5 3 L 19 3 M 9 1 L 15 1 M 10 7 L 10 16 M 14 7 L 14 16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox></Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding DeleteConfirmationVisibility}"><Button AutomationProperties.AutomationId="{x:Static local:SequenceRecorderAutomationIds.CancelDeleteRecordedEvent}" Content="Undo" ContentTemplate="{StaticResource UndoIcon}" Tag="{Binding Step}" Click="CancelDeleteRecordedEvent_Click" ToolTip="Keep this recorded event" Style="{StaticResource GhostButton}" Width="26" Height="24" MinWidth="0" MinHeight="0" Padding="5"/><Button AutomationProperties.AutomationId="{x:Static local:SequenceRecorderAutomationIds.ConfirmDeleteRecordedEvent}" Tag="{Binding Step}" Click="DeleteRecordedEvent_Click" ToolTip="Confirm deletion" Style="{StaticResource DangerButton}" Height="24" MinWidth="0" MinHeight="0" Padding="7,0" Margin="4,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="Confirm" Foreground="White" FontSize="9" VerticalAlignment="Center"/><Viewbox Width="9" Height="9" Margin="4,0,0,0"><Path Fill="White" Data="M 7 3 L 17 3 L 16 20 L 8 20 Z M 5 3 L 19 3 M 9 1 L 15 1 M 10 7 L 10 16 M 14 7 L 14 16" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox></StackPanel></Button></StackPanel>
                                </Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyRecordedEventsLabel" Text="No recorded events remain." IsHitTestVisible="False" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,13,13" Padding="20,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="CancelButton_Click" Style="{StaticResource GhostButton}"/>
                    <Button x:Name="StartButton" AutomationProperties.AutomationId="{x:Static local:SequenceRecorderAutomationIds.Start}" Content="Start recording" Click="StartButton_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
                    <Button x:Name="StopButton" AutomationProperties.AutomationId="{x:Static local:SequenceRecorderAutomationIds.Stop}" Content="Stop" Click="StopButton_Click" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Visibility="Collapsed"/>
                    <Button x:Name="UseButton" AutomationProperties.AutomationId="{x:Static local:SequenceRecorderAutomationIds.Use}" Content="Use recording" Click="UseButton_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
