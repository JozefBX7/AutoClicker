<Window x:Class="AutoClicker.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="440" Height="862" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid Margin="1">
            <Grid.RowDefinitions><RowDefinition Height="62" /><RowDefinition Height="*" /><RowDefinition Height="58" /></Grid.RowDefinitions>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="13,13,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,0"><TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="i" Click="AboutButton_Click" ToolTip="About AutoClicker" Style="{StaticResource PinButton}" Foreground="{DynamicResource TextAccentBrush}" FontWeight="Bold" FontSize="14" /><Button Click="CloseButton_Click" ToolTip="Close settings" Style="{StaticResource CloseButton}" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0"><Viewbox Width="12" Height="12"><Viewbox.RenderTransform><TranslateTransform X="-1" /></Viewbox.RenderTransform><Path Data="M 2 2 L 10 10 M 10 2 L 2 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Viewbox></Button></StackPanel></Grid>
            </Border>
            <ScrollViewer x:Name="SettingsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <ScrollViewer.Template>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Width="10"
                                       Margin="4,8,5,8"
                                       Orientation="Vertical"
                                       SmallChange="28"
                                       LargeChange="260"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       ValueChanged="SettingsScrollBar_ValueChanged"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </ScrollViewer.Template>
                <StackPanel Margin="22,14,14,20">
                    <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Interface mode" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Simple keeps one hotkey. Advanced lets a profile run multiple hotkeys at once." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,7" />
                            <ComboBox x:Name="ModeCombo">
                                <ComboBoxItem Content="Simple" Tag="Simple" />
                                <ComboBoxItem Content="Advanced" Tag="Advanced" />
                            </ComboBox>
                            <CheckBox x:Name="EnableKeyboardHotkeyModifiers" Content="Allow Ctrl/Shift/Alt Modifiers" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="When off (default), keyboard hotkeys ignore Ctrl/Shift so E still toggles while those keys are held. Turn this on only if you need distinct combinations such as Ctrl+E or Ctrl+Shift+E (which can block plain E while held)." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <Button Content="Open quick start guide" Click="QuickStartButton_Click" ToolTip="Show the Simple and Advanced mode overview" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="9,5"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="11,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Keyboard lighting" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="OpenRGB controls the selected keyboard locally (127.0.0.1:6742)." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,9" />
                            <CheckBox x:Name="EnableOpenRgb" Content="Light the hotkey with OpenRGB while AutoClicker is active" FontWeight="SemiBold" Checked="EnableOpenRgb_Changed" Unchecked="EnableOpenRgb_Changed" />
                            <StackPanel x:Name="OpenRgbOptions">
                            <CheckBox x:Name="AutoStartOpenRgb" Content="Start OpenRGB automatically when needed" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="Uses a normal local OpenRGB install; never launches a second instance." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0" />
                            <CheckBox x:Name="StopAutoStartedOpenRgb" Content="Stop OpenRGB if AutoClicker started it" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="Never stops an OpenRGB instance that was already running." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,3,0,10" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Keyboard" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4" /><ComboBox x:Name="KeyboardCombo" DisplayMemberPath="Name" /></StackPanel>
                                <Button Grid.Column="1" Content="Refresh keyboards" Click="FindKeyboards_Click" Style="{StaticResource GhostButton}" Margin="10,15,0,0" />
                            </Grid>
                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Idle OpenRGB profile" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4" /><ComboBox x:Name="OpenRgbProfileCombo" /></StackPanel>
                                <Button Grid.Column="1" Content="Refresh profiles" Click="RefreshProfiles_Click" Style="{StaticResource GhostButton}" Margin="10,15,0,0" />
                                <Button x:Name="TestProfileButton" Grid.Column="2" Content="Test profile" Click="TestProfileButton_Click" Style="{StaticResource GhostButton}" Margin="7,15,0,0" />
                            </Grid>
                            <TextBlock Text="Used for the full keyboard when no toggles are active." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Indicator colour" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4" /><StackPanel Orientation="Horizontal"><TextBox x:Name="IndicatorColorBox" Width="72" TextChanged="IndicatorColorBox_TextChanged" /><Button x:Name="ColorPickerButton" Click="PickIndicatorColor_Click" ToolTip="Choose indicator colour" Style="{StaticResource GhostButton}" Width="32" Height="31" Padding="2" Margin="6,0,0,0"><Grid Width="26" Height="25"><Border x:Name="ColorPreview" CornerRadius="3" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"/><Border Width="14" Height="14" CornerRadius="3" Background="#9A06101E" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Viewbox Width="9" Height="9"><Path Data="M 4 16 L 4 20 L 8 20 L 18 10 L 14 6 Z M 15.2 4.8 L 19.2 8.8" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox></Border></Grid></Button></StackPanel></StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Effect" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4" /><ComboBox x:Name="LightingEffectCombo" SelectionChanged="LightingEffect_Changed"><ComboBoxItem Content="Constant" /><ComboBoxItem Content="Blink" /><ComboBoxItem Content="Pulse" /></ComboBox></StackPanel>
                            </Grid>
                            <StackPanel x:Name="EffectSpeedPanel" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Effect speed" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,18,0"/><TextBlock x:Name="EffectSpeedValueLabel" Grid.Column="1" Foreground="{DynamicResource TextAccentBrush}" FontSize="10" HorizontalAlignment="Right"/></Grid><StackPanel Orientation="Horizontal" Height="24" Margin="0,2,0,2" ClipToBounds="False"><TextBlock Text="Slow" Width="34" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" VerticalAlignment="Center"/><Slider x:Name="EffectSpeedSlider" Width="190" Style="{StaticResource EffectSpeedSlider}" ValueChanged="EffectSpeedSlider_ValueChanged" Margin="6,0" VerticalAlignment="Center"/><TextBlock Text="Fast" Width="34" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" VerticalAlignment="Center" TextAlignment="Right"/></StackPanel></StackPanel>
                            <TextBlock x:Name="EffectSpeedHint" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" />
                            <TextBlock x:Name="HotkeyLightingHint" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0" />
                            <WrapPanel Margin="0,8,0,0"><Button x:Name="TestRgbButton" Content="Test keyboard lighting" ToolTip="Flashes the selected keyboard three times, then restores its previous colours." Click="TestRgbButton_Click" Style="{StaticResource GhostButton}"/><Button x:Name="TestEffectButton" Content="Test keyboard effect" ToolTip="Shows the selected lighting effect across the keyboard, then restores its previous colours. Click again to stop it early." Click="TestEffectButton_Click" Style="{StaticResource GhostButton}" Margin="7,0,0,0"/><Button x:Name="ClearStuckLightingButton" Width="31" Height="31" Padding="0" ToolTip="Clear stuck keyboard lighting. Re-sends the selected keyboard's current colours without choosing a new OpenRGB effect." Click="ClearStuckLightingButton_Click" Style="{StaticResource GhostButton}" Margin="7,0,0,0"><Viewbox Width="15" Height="15"><Canvas Width="20" Height="20"><Path Data="M 7 6 L 7 4.8 A 1.8 1.8 0 0 1 8.8 3 L 11.2 3 A 1.8 1.8 0 0 1 13 4.8 L 13 6 M 3 6.5 H 17 A 1.5 1.5 0 0 1 18.5 8 V 16 A 1.5 1.5 0 0 1 17 17.5 H 3 A 1.5 1.5 0 0 1 1.5 16 V 8 A 1.5 1.5 0 0 1 3 6.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.65" StrokeLineJoin="Round" Fill="Transparent"/><Path Data="M 9 9 H 11 V 11 H 13 V 13 H 11 V 15 H 9 V 13 H 7 V 11 H 9 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></Viewbox></Button></WrapPanel>
                            <TextBlock x:Name="ConnectionStatus" Text="OpenRGB must be running with its SDK server enabled." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <CheckBox x:Name="EnableCrashRecovery" Content="Restart after an unexpected crash" FontWeight="SemiBold" />
                    <TextBlock Text="Intentional closures and forced terminations never restart the app. Repeated crashes are paused automatically." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Automation worker priority" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Applies to Simple and Advanced actions. Normal is recommended; Above Normal can help on busy systems but may compete with the foreground game or app." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,7" />
                            <ComboBox x:Name="WorkerPriorityCombo" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Normal (recommended)" Tag="Normal" />
                                <ComboBoxItem Content="Above Normal (compatibility)" Tag="AboveNormal" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Cadence diagnostics" Style="{StaticResource SectionTitle}" />
                            <CheckBox x:Name="EnableCadenceDiagnostics" Content="Write automation timing statistics to AutoClicker.log" FontWeight="SemiBold" Margin="0,5,0,0" />
                            <TextBlock Text="For troubleshooting only." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Backup and restore" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Focused restore accepts its own export or an Everything backup, using only the selected part." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="Everything" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Export" Click="ExportEverything_Click" Style="{StaticResource GhostButton}" Padding="9,5" Margin="8,0,0,0"/><Button Grid.Column="2" Content="Restore" Click="ImportEverything_Click" Style="{StaticResource GhostButton}" Padding="9,5" Margin="5,0,0,0"/>
                                <TextBlock Grid.Row="1" Text="Simple mode settings" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,6,0,0"/><Button Grid.Row="1" Grid.Column="1" Content="Export" Click="ExportSimple_Click" Style="{StaticResource GhostButton}" Padding="9,5" Margin="8,6,0,0"/><Button Grid.Row="1" Grid.Column="2" Content="Restore" Click="ImportSimple_Click" Style="{StaticResource GhostButton}" Padding="9,5" Margin="5,6,0,0"/>
                                <TextBlock Grid.Row="2" Text="Advanced mode &amp; profiles" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,6,0,0"/><Button Grid.Row="2" Grid.Column="1" Content="Export" Click="ExportAdvanced_Click" Style="{StaticResource GhostButton}" Padding="9,5" Margin="8,6,0,0"/><Button Grid.Row="2" Grid.Column="2" Content="Restore" Click="ImportAdvanced_Click" Style="{StaticResource GhostButton}" Padding="9,5" Margin="5,6,0,0"/>
                                <TextBlock Grid.Row="3" Text="Custom sequences" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,6,0,0"/><Button Grid.Row="3" Grid.Column="1" Content="Export" Click="ExportSequences_Click" Style="{StaticResource GhostButton}" Padding="9,5" Margin="8,6,0,0"/><Button Grid.Row="3" Grid.Column="2" Content="Restore" Click="ImportSequences_Click" Style="{StaticResource GhostButton}" Padding="9,5" Margin="5,6,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Check GitHub Releases manually. Updates install only after confirmation." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,7" />
                            <WrapPanel>
                                <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click" Style="{StaticResource GhostButton}" Margin="0,0,0,7" />
                                <Button Content="Open releases" Click="OpenReleases_Click" Style="{StaticResource GhostButton}" Margin="7,0,0,7" />
                                <Button x:Name="DownloadUpdateButton" Content="Download update" Click="DownloadUpdate_Click" Style="{StaticResource PrimaryButton}" Margin="7,0,0,7" Visibility="Collapsed" />
                            </WrapPanel>
                            <TextBlock x:Name="UpdateStatus" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" />
                            <StackPanel x:Name="ReleaseHistoryPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <TextBlock Text="Recent changes" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ItemsControl x:Name="ReleaseHistoryList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,5" Margin="0,0,0,5">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Tag}" Foreground="{DynamicResource TextStrongBrush}" FontSize="10" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Notes}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,13,13" Padding="20,10"><Grid><Button Content="Reset to defaults" ToolTip="Restore the original AutoClicker defaults, including a 100 ms interval." Click="RestoreDefaults_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="CloseButton_Click" Style="{StaticResource GhostButton}" /><Button Content="Save settings" Click="SaveButton_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" /></StackPanel></Grid></Border>
        </Grid>
    </Border>
</Window>
