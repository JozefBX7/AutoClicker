<Window x:Class="AutoClicker.QuickStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to AutoClicker" Icon="/AutoClicker;component/Assets/AutoClickerIcon.ico" Width="440" Height="354" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid Margin="1">
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="13,13,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"><StackPanel Margin="20,0" VerticalAlignment="Center"><TextBlock Text="Welcome to AutoClicker" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"/><TextBlock Text="Quick, precise input when you need it." FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/></StackPanel></Border>
            <StackPanel Grid.Row="1" Margin="20,17">
                <TextBlock Text="Simple mode" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Choose an action and interval, then use Start or the F6 hotkey. F6 stops it too." Style="{StaticResource SectionHint}" TextWrapping="Wrap" Margin="0,2,0,13"/>
                <TextBlock Text="Advanced mode" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Switch from the header to keep named profiles with several independent hotkeys that can run together." Style="{StaticResource SectionHint}" TextWrapping="Wrap" Margin="0,2,0,13"/>
                <TextBlock Text="Optional keyboard lighting" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="With OpenRGB installed, Settings → Keyboard lighting can light active hotkeys on compatible RGB keyboards." Style="{StaticResource SectionHint}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,13,13" Padding="20,10"><Grid><TextBlock VerticalAlignment="Center" FontSize="11"><Hyperlink NavigateUri="https://github.com/JozefBX7/AutoClicker/wiki" RequestNavigate="WikiLink_RequestNavigate" Foreground="{DynamicResource TextAccentBrush}" ToolTip="Open the AutoClicker Wiki">View the Wiki</Hyperlink></TextBlock><Button Content="Get started" Click="GetStartedButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/></Grid></Border>
        </Grid>
    </Border>
</Window>
