<Window x:Class="AutoClicker.ResetOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset options" Width="430" Height="380" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid Margin="1"><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="13,13,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid Margin="20,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="Reset options" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"/><TextBlock Text="Choose exactly what to restore." FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel><Button Content="×" Click="CloseButton_Click" ToolTip="Close" Style="{StaticResource CloseButton}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
            <StackPanel Grid.Row="1" Margin="20,14"><Button Content="Reset Simple mode" Tag="SimpleMode" Click="ResetButton_Click" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"/><TextBlock Text="Restores only the simple-mode startup configuration to 100 ms and F6." Style="{StaticResource SectionHint}" Margin="5,2,0,8"/><Button Content="Reset Advanced mode" Tag="AdvancedMode" Click="ResetButton_Click" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"/><TextBlock Text="Removes only saved profiles and restores one General action." Style="{StaticResource SectionHint}" Margin="5,2,0,8"/><Button Content="Reset Advanced shared defaults" Tag="SharedDefaults" Click="ResetButton_Click" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"/><TextBlock Text="Restores only the global Advanced values inherited by profiles and hotkeys." Style="{StaticResource SectionHint}" Margin="5,2,0,8"/><Button Content="Reset everything" Tag="Everything" Click="ResetButton_Click" Style="{StaticResource DangerButton}" HorizontalContentAlignment="Left"/></StackPanel>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,13,13" Padding="20,10"><Button Content="Cancel" Click="CloseButton_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"/></Border>
        </Grid>
    </Border>
</Window>
