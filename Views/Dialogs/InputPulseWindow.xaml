<Window x:Class="AutoClicker.InputPulseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input pulse" Icon="/AutoClicker;component/Assets/AutoClickerIcon.ico" Width="330" Height="280" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid Margin="1">
            <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="58" /></Grid.RowDefinitions>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="13,13,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"><StackPanel Margin="20,0" VerticalAlignment="Center"><TextBlock Text="Input pulse" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}" /><TextBlock x:Name="ScopeLabel" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" /></StackPanel></Border>
            <StackPanel Grid.Row="1" Margin="20,16"><TextBlock Text="How long each click or key press stays down." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" /><ComboBox x:Name="PulseCombo" Margin="0,12,0,0"><ComboBoxItem Content="Off (instant)" Tag="0" /><ComboBoxItem Content="1 ms" Tag="1" /><ComboBoxItem Content="2 ms" Tag="2" /><ComboBoxItem Content="3 ms" Tag="3" /><ComboBoxItem Content="4 ms" Tag="4" /><ComboBoxItem Content="5 ms" Tag="5" /></ComboBox><TextBlock Text="A short pulse can help games detect synthetic input." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" /><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Custom sequences use this pulse unless their editor opts out." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap"/><Border Grid.Column="1" Width="18" Height="18" CornerRadius="9" Background="Transparent" BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="1" ToolTip="Each custom sequence inherits this global pulse by default. In the sequence editor, turn off Use global input pulse to send every click and key step immediately instead." VerticalAlignment="Center" Margin="7,0,0,0"><TextBlock Text="i" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></StackPanel>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,13,13" Padding="20,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="CancelButton_Click" Style="{StaticResource GhostButton}" /><Button Content="Save" Click="SaveButton_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" /></StackPanel></Border>
        </Grid>
    </Border>
</Window>
