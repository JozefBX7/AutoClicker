<Window x:Class="AutoClicker.TargetWindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose target window" Icon="/AutoClicker;component/Assets/AutoClickerIcon.ico" Width="460" Height="420" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid Margin="1">
            <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="58" /></Grid.RowDefinitions>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="13,13,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,0"><TextBlock Text="Choose target window" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}" /><Button HorizontalAlignment="Right" Click="CloseButton_Click" ToolTip="Close" Style="{StaticResource CloseButton}" Foreground="{DynamicResource TextMutedBrush}"><Viewbox Width="12" Height="12"><Path Data="M 2 2 L 10 10 M 10 2 L 2 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" /></Viewbox></Button></Grid>
            </Border>
            <Grid Grid.Row="1" Margin="20,16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Select a currently visible window. AutoClicker sends input only while it is active." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" /><Grid Grid.Row="1"><ListBox x:Name="WindowList" DisplayMemberPath="DisplayName" SelectionChanged="WindowList_SelectionChanged" MouseDoubleClick="WindowList_MouseDoubleClick" /><TextBlock x:Name="EmptyLabel" Text="No visible windows were found." Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" /></Grid></Grid>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,13,13" Padding="20,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="CloseButton_Click" Style="{StaticResource GhostButton}" /><Button x:Name="SelectButton" Content="Use window" Click="SelectButton_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False" /></StackPanel></Border>
        </Grid>
    </Border>
</Window>
