<Window x:Class="AutoClicker.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Indicator colour" Icon="/AutoClicker;component/Assets/AutoClickerIcon.ico" Width="390" Height="278" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid Margin="1"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="13,13,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"><StackPanel Margin="20,0" VerticalAlignment="Center"><TextBlock Text="Indicator colour" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"/><TextBlock Text="Pick a colour, then preview the selected hotkey safely." FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
            <StackPanel Grid.Row="1" Margin="20,14">
                <StackPanel Orientation="Horizontal"><Border x:Name="ColorSwatch" Width="54" Height="42" CornerRadius="7" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"/><StackPanel Margin="10,0,0,0"><TextBox x:Name="HexBox" Width="82" IsReadOnly="True" HorizontalContentAlignment="Center"/><Button x:Name="PickColorButton" Content="Pick colour" Click="PickColorButton_Click" Style="{StaticResource GhostButton}" Margin="0,6,0,0"/></StackPanel></StackPanel>
                <Border Background="{DynamicResource LiveFlashBrush}" BorderBrush="{DynamicResource LiveFlashBorderBrush}" BorderThickness="1" CornerRadius="5" MinHeight="42" Padding="9,6" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="PreviewStatus" Text="The selected hotkey will stay lit for 5 seconds after you pick a colour as a preview." Foreground="{DynamicResource TextStrongBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="PreviewButton" Grid.Column="1" Content="▶ Preview" Click="PreviewButton_Click" Style="{StaticResource GhostButton}" Padding="8,3" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,13,13" Padding="20,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="CancelButton_Click" Style="{StaticResource GhostButton}"/><Button Content="Use colour" Click="ConfirmButton_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/></StackPanel></Border>
        </Grid>
    </Border>
</Window>
