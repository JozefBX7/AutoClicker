<Window x:Class="AutoClicker.SequenceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom sequence" Icon="Assets/AutoClickerIcon.ico" Width="470" Height="430" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid Margin="1"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="13,13,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid Margin="20,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="Custom sequence" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"/><TextBlock Text="Runs each step in order; the main interval is between sequences. The final delay is ignored." FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel><Button Click="CloseButton_Click" ToolTip="Close editor" Style="{StaticResource CloseButton}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"><Viewbox Width="12" Height="12"><Path Data="M 2 2 L 10 10 M 10 2 L 2 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"/></Viewbox></Button></Grid></Border>
            <StackPanel Grid.Row="1" Margin="20,14">
                <ListBox x:Name="StepsList" Height="142" DisplayMemberPath="."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,12"><Button Content="Move up" Click="MoveUp_Click" Style="{StaticResource GhostButton}"/><Button Content="Move down" Click="MoveDown_Click" Style="{StaticResource GhostButton}" Margin="6,0,0,0"/><Button Content="Remove" Click="Remove_Click" Style="{StaticResource GhostButton}" Margin="6,0,0,0"/></StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Add action" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ActionCombo" SelectionChanged="ActionCombo_SelectionChanged"><ComboBoxItem Content="Left click" Tag="Left"/><ComboBoxItem Content="Right click" Tag="Right"/><ComboBoxItem Content="Middle click" Tag="Middle"/><ComboBoxItem Content="Space" Tag="Space"/><ComboBoxItem Content="Enter" Tag="Enter"/><ComboBoxItem x:Name="CustomKeyItem" Content="Picked key" Tag="Custom"/><ComboBoxItem Content="Pick a key…" Tag="Pick"/></ComboBox></StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Delay after (ms)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DelayBox" Text="100"/></StackPanel>
                    <Button Grid.Column="2" Content="Add" Click="Add_Click" Style="{StaticResource PrimaryButton}" Margin="8,15,0,0"/>
                </Grid>
                <TextBlock x:Name="HintLabel" Text="Select an action, set the delay before the next step, then add it." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,8,0,0"/>
            </StackPanel>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,13,13" Padding="20,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="CloseButton_Click" Style="{StaticResource GhostButton}"/><Button Content="Use sequence" Click="Save_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/></StackPanel></Border>
        </Grid>
    </Border>
</Window>
