<Window x:Class="AutoClicker.SequenceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom sequence" Icon="Assets/AutoClickerIcon.ico" Width="470" Height="430" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid Margin="1"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="13,13,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid Margin="20,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="Custom sequence" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"/><TextBlock Text="Runs each step in order; the main interval is between sequences. The final delay is ignored." FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel><Button Click="CloseButton_Click" ToolTip="Close editor" Style="{StaticResource CloseButton}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"><Viewbox Width="12" Height="12"><Path Data="M 2 2 L 10 10 M 10 2 L 2 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"/></Viewbox></Button></Grid></Border>
            <StackPanel Grid.Row="1" Margin="20,14">
                <ListBox x:Name="StepsList" Height="142" DisplayMemberPath="."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,12"><Button Content="Move up" Click="MoveUp_Click" Style="{StaticResource GhostButton}"/><Button Content="Move down" Click="MoveDown_Click" Style="{StaticResource GhostButton}" Margin="6,0,0,0"/><Button Content="Remove" Click="Remove_Click" Style="{StaticResource GhostButton}" Margin="6,0,0,0"/></StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Add action" Style="{StaticResource FieldLabel}"/><StackPanel Orientation="Horizontal">
                        <Button x:Name="LeftActionButton" CommandParameter="Left" Click="MouseActionButton_Click" ToolTip="Add left click" Style="{StaticResource PinButton}"><Viewbox Width="17" Height="17"><Grid Width="24" Height="24"><Path Data="M 12 2 C 7.5 2 5 5.2 5 10.2 V 14.5 C 5 19.2 8 22 12 22 C 16 22 19 19.2 19 14.5 V 10.2 C 19 5.2 16.5 2 12 2 Z" Stroke="{DynamicResource TextAccentBrush}" StrokeThickness="1.7" Fill="Transparent"/><Path Data="M 12 3 V 10.5 M 6 10.5 H 12 V 3 C 8.3 3.3 6.2 6 6 10.5 Z" Fill="{DynamicResource TextAccentBrush}" Opacity="0.75"/></Grid></Viewbox></Button>
                        <Button x:Name="MiddleActionButton" CommandParameter="Middle" Click="MouseActionButton_Click" ToolTip="Add middle click" Style="{StaticResource PinButton}" Margin="5,0,0,0"><Viewbox Width="17" Height="17"><Grid Width="24" Height="24"><Path Data="M 12 2 C 7.5 2 5 5.2 5 10.2 V 14.5 C 5 19.2 8 22 12 22 C 16 22 19 19.2 19 14.5 V 10.2 C 19 5.2 16.5 2 12 2 Z" Stroke="{DynamicResource TextAccentBrush}" StrokeThickness="1.7" Fill="Transparent"/><Path Data="M 10 3 H 14 V 10 H 10 Z" Fill="{DynamicResource TextAccentBrush}" Opacity="0.75"/></Grid></Viewbox></Button>
                        <Button x:Name="RightActionButton" CommandParameter="Right" Click="MouseActionButton_Click" ToolTip="Add right click" Style="{StaticResource PinButton}" Margin="5,0,0,0"><Viewbox Width="17" Height="17"><Grid Width="24" Height="24"><Path Data="M 12 2 C 7.5 2 5 5.2 5 10.2 V 14.5 C 5 19.2 8 22 12 22 C 16 22 19 19.2 19 14.5 V 10.2 C 19 5.2 16.5 2 12 2 Z" Stroke="{DynamicResource TextAccentBrush}" StrokeThickness="1.7" Fill="Transparent"/><Path Data="M 12 3 V 10.5 M 12 3 V 10.5 H 18 C 17.8 6 15.7 3.3 12 3 Z" Fill="{DynamicResource TextAccentBrush}" Opacity="0.75"/></Grid></Viewbox></Button>
                        <Button x:Name="KeyboardActionButton" Click="KeyboardActionButton_Click" ToolTip="Add a keyboard key" Style="{StaticResource PinButton}" Margin="5,0,0,0"><Viewbox Width="18" Height="18"><Grid Width="24" Height="24"><Rectangle Width="19" Height="12" RadiusX="2" RadiusY="2" Stroke="{DynamicResource TextAccentBrush}" StrokeThickness="1.7" HorizontalAlignment="Center" VerticalAlignment="Center"/><Path Data="M 6 10 H 8 M 10 10 H 12 M 14 10 H 16 M 18 10 H 19 M 6 14 H 16 M 18 14 H 19" Stroke="{DynamicResource TextAccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round"/></Grid></Viewbox></Button>
                    </StackPanel></StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Delay after (ms)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DelayBox" Text="100"/></StackPanel>
                    <Button Grid.Column="2" Content="Add" Click="Add_Click" Style="{StaticResource PrimaryButton}" Margin="8,15,0,0"/>
                </Grid>
                <TextBlock x:Name="HintLabel" Text="Choose an action, set the delay before the next step, then add it." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,8,0,0"/>
            </StackPanel>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,13,13" Padding="20,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="CloseButton_Click" Style="{StaticResource GhostButton}"/><Button Content="Use sequence" Click="Save_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/></StackPanel></Border>
        </Grid>
    </Border>
</Window>
