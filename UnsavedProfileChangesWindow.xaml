<Window x:Class="AutoClicker.UnsavedProfileChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved profile changes" Icon="Assets/AutoClickerIcon.ico" Width="430" Height="248" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid Margin="1">
            <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="58" /></Grid.RowDefinitions>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="13,13,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"><TextBlock Text="Unsaved profile changes" Margin="20,0" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}" /></Border>
            <StackPanel Grid.Row="1" Margin="20,15" VerticalAlignment="Center"><TextBlock x:Name="MessageLabel" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/><StackPanel x:Name="ProfileNamePanel" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock Text="Save profile as" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ProfileNameBox" MaxLength="60"/><TextBlock x:Name="ValidationLabel" Foreground="{DynamicResource WarningBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel></StackPanel>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,13,13" Padding="20,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="CancelButton_Click" Style="{StaticResource GhostButton}" /><Button Content="Discard" Click="DiscardButton_Click" Style="{StaticResource DangerButton}" Margin="8,0,0,0" /><Button Content="Save" Click="SaveButton_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" /></StackPanel></Border>
        </Grid>
    </Border>
</Window>
