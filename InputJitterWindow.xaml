<Window x:Class="AutoClicker.InputJitterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input jitter" Icon="Assets/AutoClickerIcon.ico" Width="330" Height="250" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner" PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid Margin="1">
            <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="58" /></Grid.RowDefinitions>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="13,13,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"><TextBlock Text="Input jitter" Margin="20,0" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}" /></Border>
            <StackPanel Grid.Row="1" Margin="20,16"><TextBlock Text="Randomly vary each interval earlier or later." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="Maximum variation" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Seconds" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SecondsBox" Text="0" /></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Millis" Style="{StaticResource FieldLabel}" /><TextBox x:Name="MillisecondsBox" Text="0" /></StackPanel></Grid><TextBlock Text="Off uses the exact configured interval. Jitter keeps the effective delay at least 1 ms." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,13,13" Padding="20,10"><Grid><Button Content="Clear" Click="ClearButton_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="CancelButton_Click" Style="{StaticResource GhostButton}" /><Button Content="Save" Click="SaveButton_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" /></StackPanel></Grid></Border>
        </Grid>
    </Border>
</Window>
