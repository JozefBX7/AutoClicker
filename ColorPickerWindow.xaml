<Window x:Class="AutoClicker.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Indicator colour" Icon="Assets/AutoClickerIcon.ico" Width="360" Height="332" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid Margin="1"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="13,13,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"><StackPanel Margin="20,0" VerticalAlignment="Center"><TextBlock Text="Indicator colour" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"/><TextBlock x:Name="PreviewHint" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
            <StackPanel Grid.Row="1" Margin="20,14">
                <Grid Height="48"><Border x:Name="ColorSwatch" CornerRadius="7" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"/><TextBox x:Name="HexBox" Width="92" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" TextChanged="HexBox_TextChanged"/></Grid>
                <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><TextBlock Text="Red" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="ChannelSlider_ValueChanged"/><TextBlock x:Name="RedValue" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/></Grid>
                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><TextBlock Text="Green" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><Slider x:Name="GreenSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="ChannelSlider_ValueChanged"/><TextBlock x:Name="GreenValue" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/></Grid>
                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><TextBlock Text="Blue" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><Slider x:Name="BlueSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="ChannelSlider_ValueChanged"/><TextBlock x:Name="BlueValue" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/></Grid>
            </StackPanel>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,13,13" Padding="20,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="CancelButton_Click" Style="{StaticResource GhostButton}"/><Button Content="Use colour" Click="ConfirmButton_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/></StackPanel></Border>
        </Grid>
    </Border>
</Window>
