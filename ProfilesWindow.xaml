<Window x:Class="AutoClicker.ProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profiles" Width="520" Height="430" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="13,13,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid Margin="20,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="Profiles" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"/><TextBlock Text="Each hotkey can run its own action and target app." FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel><Button Click="CloseButton_Click" ToolTip="Close profiles" Style="{StaticResource CloseButton}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"><Viewbox Width="12" Height="12"><Path Data="M 2 2 L 10 10 M 10 2 L 2 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"/></Viewbox></Button></Grid></Border>
            <Grid Grid.Row="1" Margin="20,16"><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Profiles" Style="{StaticResource FieldLabel}"/><ListBox x:Name="ProfilesList" DisplayMemberPath="Name" SelectionChanged="ProfilesList_SelectionChanged" Height="216" Margin="0,6,0,8"/><StackPanel Orientation="Horizontal"><Button Content="+" Click="AddProfile_Click" ToolTip="Add a profile" Style="{StaticResource GhostButton}" Width="30" Padding="0"/><Button Content="×" Click="RemoveProfile_Click" ToolTip="Remove selected profile" Style="{StaticResource DangerButton}" Width="30" Padding="0" Margin="6,0,0,0"/></StackPanel></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock x:Name="ActionsTitle" Text="Hotkeys" Style="{StaticResource FieldLabel}"/><ListBox x:Name="ActionsList" DisplayMemberPath="DisplayName" SelectionMode="Extended" Height="150" Margin="0,6,0,8" SelectionChanged="ActionsList_SelectionChanged"/><StackPanel Orientation="Horizontal"><Button Content="+" Click="AddAction_Click" ToolTip="Add an action using the current main-window settings" Style="{StaticResource GhostButton}" Width="30" Padding="0"/><Button Content="×" Click="RemoveAction_Click" ToolTip="Remove selected hotkey action" Style="{StaticResource DangerButton}" Width="30" Padding="0" Margin="6,0,0,0"/></StackPanel><TextBlock Text="Copy selected to" Style="{StaticResource FieldLabel}" Margin="0,14,0,3"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="CopyTargetCombo" DisplayMemberPath="Name"/><Button Grid.Column="1" Content="Copy" Click="CopyActions_Click" Style="{StaticResource GhostButton}" Margin="6,0,0,0"/></Grid><TextBlock x:Name="HintLabel" Text="Select a profile to use it, or manage its hotkeys here." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,13,13" Padding="20,13"><DockPanel><Button Content="Done" Click="Done_Click" Style="{StaticResource PrimaryButton}" Padding="14,9" HorizontalAlignment="Right" DockPanel.Dock="Right"/><TextBlock Text="Use Save in the main footer to persist profile changes." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center"/></DockPanel></Border>
        </Grid>
    </Border>
</Window>
