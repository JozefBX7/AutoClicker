<Window x:Class="AutoClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoClicker"
        Title="AutoClicker" Icon="Assets/AutoClickerIcon.ico" Width="522" Height="580" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown" SourceInitialized="Window_SourceInitialized" Closing="Window_Closing">
    <Window.Resources>
        <local:AdvancedActionLabelConverter x:Key="AdvancedActionLabelConverter" />
    </Window.Resources>
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="16" SnapsToDevicePixels="True">
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="FooterRow" Height="82" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" CornerRadius="15,15,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown" MouseRightButtonUp="Header_MouseRightButtonUp">
                <Grid Margin="22,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AutoClicker" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}" />
                        <TextBlock Text="Pretty, fast" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="SimpleHotkeyHeader" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <TextBlock Text="HOTKEY  " FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HotkeyLabel" Text="F6" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource HotkeyTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Width="1" Background="{DynamicResource ControlBorderBrush}" />
                                <Button x:Name="HotkeyButton" Content="Edit" ContentTemplate="{StaticResource HotkeyEditIcon}" Click="HotkeyButton_Click" ToolTip="Change hotkey" Style="{StaticResource HeaderEmbeddedIconButton}" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="AdvancedHelpButton" Content="?" Click="AdvancedHelpButton_Click" ToolTip="Advanced-mode help" Style="{StaticResource PinButton}" FontSize="14" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,0,3,0" />
                        <Button x:Name="ModeButton" Content="Simple" Click="ModeButton_Click" ToolTip="Switch to Advanced profiles" Style="{StaticResource HeaderButton}" FontSize="10" Padding="8,5" Margin="0,0,6,0" />
                        <Button x:Name="SettingsButton" Content="Settings" Click="SettingsButton_Click" Style="{StaticResource HeaderButton}" Margin="0,0,6,0" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ThemeButton" Content="Theme" ContentTemplate="{StaticResource MoonIcon}" Click="ThemeButton_Click" ToolTip="Switch to light mode" Style="{StaticResource PinButton}" />
                            <Button x:Name="PinButton" Content="Pin" ContentTemplate="{StaticResource PinIcon}" Click="PinButton_Click" ToolTip="Keep on top" Style="{StaticResource PinButton}" Margin="3,0,0,0" />
                            <Button Click="CloseButton_Click" ToolTip="Quit the app" Style="{StaticResource CloseButton}" Foreground="{DynamicResource TextMutedBrush}" Margin="3,0,0,0">
                                <Viewbox Width="12" Height="12">
                                    <Viewbox.RenderTransform>
                                        <TranslateTransform X="-1" />
                                    </Viewbox.RenderTransform>
                                    <Path Data="M 2 2 L 10 10 M 10 2 L 2 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="SettingsContent" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,16,22,8">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="IntervalCard" Style="{StaticResource Card}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Interval" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="IntervalHint" Text="Time between clicks" Style="{StaticResource SectionHint}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Hours" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="HoursBox" Text="0" LostKeyboardFocus="IntervalBox_LostKeyboardFocus" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Minutes" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MinutesBox" Text="0" LostKeyboardFocus="IntervalBox_LostKeyboardFocus" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                        <TextBlock Text="Seconds" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="SecondsBox" Text="0" LostKeyboardFocus="IntervalBox_LostKeyboardFocus" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="6,0,0,0">
                                        <TextBlock Text="Millis" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MillisBox" Text="100" LostKeyboardFocus="IntervalBox_LostKeyboardFocus" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ActionCard" Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Action" Style="{StaticResource SectionTitle}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Border x:Name="InputJitterOverrideHost" Background="Transparent" Tag="InputJitter" PreviewMouseLeftButtonDown="SharedBehaviorSurface_PreviewMouseLeftButtonDown" MouseEnter="SharedBehaviorSurface_MouseEnter" MouseLeave="SharedBehaviorSurface_MouseLeave"><Grid><Button x:Name="InputJitterButton" Content="Jitter Off" Click="InputJitterButton_Click" Style="{StaticResource ActiveGhostButton}" FontSize="10" Padding="7,3" ToolTip="Configure random extra delay between actions"/><Border x:Name="InputJitterSharedOverlay" Visibility="Collapsed" Background="{DynamicResource ControlBrush}" Opacity="0.97" CornerRadius="5" IsHitTestVisible="False"><TextBlock Text="Override" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border><Border x:Name="InputPulseOverrideHost" Background="Transparent" Tag="InputPulse" PreviewMouseLeftButtonDown="SharedBehaviorSurface_PreviewMouseLeftButtonDown" MouseEnter="SharedBehaviorSurface_MouseEnter" MouseLeave="SharedBehaviorSurface_MouseLeave" Margin="5,0,0,0"><Grid><Button x:Name="InputPulseButton" Content="Pulse" Click="InputPulseButton_Click" Style="{StaticResource GhostButton}" FontSize="10" Padding="7,3" ToolTip="Configure click and key press duration"/><Border x:Name="InputPulseSharedOverlay" Visibility="Collapsed" Background="{DynamicResource ControlBrush}" Opacity="0.97" CornerRadius="5" IsHitTestVisible="False"><TextBlock Text="Override" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border></StackPanel>
                                </Grid>
                                <TextBlock x:Name="ActionEditorHint" Text="Mouse or keyboard input" Style="{StaticResource SectionHint}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Input" Style="{StaticResource FieldLabel}" />
                                        <Grid>
                                        <ComboBox x:Name="ButtonCombo" SelectedIndex="0" SelectionChanged="ActionCombo_SelectionChanged">
                                            <ComboBoxItem Content="Left click" Tag="Left" />
                                            <ComboBoxItem Content="Right click" Tag="Right" />
                                            <ComboBoxItem Content="Middle click" Tag="Middle" />
                                            <ComboBoxItem Content="Space" Tag="Space" />
                                            <ComboBoxItem Content="Enter" Tag="Enter" />
                                            <ComboBoxItem x:Name="CustomKeyItem" Content="Custom key" Tag="Custom" />
                                            <ComboBoxItem x:Name="SequenceItem" Content="Custom sequence" Tag="Sequence" IsEnabled="False" />
                                            <ComboBoxItem x:Name="EmptySequencePresetsItem" Content="  No saved sequences have been added yet." IsEnabled="False" />
                                            <ComboBoxItem x:Name="EditSequenceItem" Content="Open custom sequence editor" Tag="EditSequence" />
                                        </ComboBox>
                                        <TextBlock x:Name="ActionPlaceholder" Text="Pick an action" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="1" Visibility="Collapsed" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Action" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="TypeCombo" SelectedIndex="0" SelectionChanged="TypeCombo_SelectionChanged">
                                            <ComboBoxItem Content="Single" />
                                            <ComboBoxItem Content="Double" />
                                            <ComboBoxItem Content="Hold" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="RepeatCard" Style="{StaticResource Card}" Margin="0,0,6,0" Tag="Repeat" PreviewMouseLeftButtonDown="SharedBehaviorSurface_PreviewMouseLeftButtonDown" MouseEnter="SharedBehaviorSurface_MouseEnter" MouseLeave="SharedBehaviorSurface_MouseLeave">
                            <Grid>
                            <StackPanel x:Name="RepeatContent">
                                <TextBlock Text="Repeat" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Stop automatically, or keep going" Style="{StaticResource SectionHint}" />
                                <RadioButton x:Name="UntilStoppedRadio" GroupName="RepeatMode" Content="Repeat until stopped" IsChecked="True" Margin="0,12,0,7" Checked="RepeatMode_Changed" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="CountRadio" GroupName="RepeatMode" Content="Repeat" Checked="RepeatMode_Changed" />
                                <TextBox x:Name="CountBox" Text="10" Width="52" Margin="8,-4,6,0" IsEnabled="False" TextChanged="RepeatDefaultFieldChanged" />
                                    <TextBlock Text="times" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                            <Border x:Name="RepeatSharedOverlay" Visibility="Collapsed" Background="{DynamicResource ControlBrush}" Opacity="0.97" CornerRadius="8" IsHitTestVisible="False">
                                <TextBlock x:Name="RepeatSharedOverlayLabel" Text="Click to override repeat for this hotkey" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18" />
                            </Border>
                            </Grid>
                        </Border>
                        <Border x:Name="PositionCard" Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0" Tag="Position" PreviewMouseLeftButtonDown="SharedBehaviorSurface_PreviewMouseLeftButtonDown" MouseEnter="SharedBehaviorSurface_MouseEnter" MouseLeave="SharedBehaviorSurface_MouseLeave">
                            <Grid>
                            <StackPanel x:Name="PositionContent" Margin="0,0,-5,0">
                                <TextBlock Text="Position" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Use the cursor, or fixed coordinates" Style="{StaticResource SectionHint}" />
                                <RadioButton x:Name="CurrentPositionRadio" GroupName="PositionMode" Content="Current cursor position" IsChecked="True" Margin="0,12,0,7" Checked="PositionMode_Changed" />
                                <Grid Width="210">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="54.272" />
                                        <ColumnDefinition Width="8.697"/>
                                        <ColumnDefinition Width="1.183"/>
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="FixedPositionRadio" GroupName="PositionMode" Content="Fixed" Checked="PositionMode_Changed" Grid.ColumnSpan="2" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="X" Style="{StaticResource InlineLabel}" Margin="26,0,38,0" Grid.ColumnSpan="2" />
                                    <TextBox x:Name="XBox" Grid.Column="2" Text="0" IsEnabled="False" TextChanged="PositionDefaultFieldChanged" Margin="8,-4,12,0" RenderTransformOrigin="0.5,0.5" >
                                        <TextBox.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform/>
                                                <SkewTransform AngleY="0.007"/>
                                                <RotateTransform/>
                                                <TranslateTransform Y="-0.001"/>
                                            </TransformGroup>
                                        </TextBox.RenderTransform>
                                    </TextBox>
                                    <TextBlock Grid.Column="2" Text="Y" Style="{StaticResource InlineLabel}" Margin="63,0,30,0" Grid.ColumnSpan="3" />
                                    <TextBox x:Name="YBox" Grid.Column="4" Text="0" IsEnabled="False" TextChanged="PositionDefaultFieldChanged" Margin="3,-4,1,0" RenderTransformOrigin="0.5,0.5" >
                                        <TextBox.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform/>
                                                <SkewTransform AngleY="0.146"/>
                                                <RotateTransform/>
                                                <TranslateTransform Y="0.06"/>
                                            </TransformGroup>
                                        </TextBox.RenderTransform>
                                    </TextBox>
                                    <Button x:Name="PickPositionButton" Grid.Column="5" Click="PickPositionButton_Click" Style="{StaticResource GhostButton}" ToolTip="Pick a position anywhere on screen" Width="22" Height="22" Padding="0" Margin="3,3,-15,2" RenderTransformOrigin="0.5,0.5" Grid.ColumnSpan="3">
                                        <Button.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform/>
                                                <SkewTransform AngleY="0.298"/>
                                                <RotateTransform/>
                                                <TranslateTransform Y="0.057"/>
                                            </TransformGroup>
                                        </Button.RenderTransform>
                                        <Viewbox Width="12" Height="12">
                                            <Path Data="M 2 11 L 2 8 L 7.5 2.5 L 10.5 5.5 L 5 11 Z M 7.5 2.5 L 8.5 1.5 L 11.5 4.5 L 10.5 5.5 M 3 8 L 5 10" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <Border x:Name="PositionSharedOverlay" Visibility="Collapsed" Background="{DynamicResource ControlBrush}" Opacity="0.97" CornerRadius="8" IsHitTestVisible="False">
                                <TextBlock x:Name="PositionSharedOverlayLabel" Text="Click to override position for this hotkey" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18" />
                            </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="TargetWindowCard" Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0" Tag="TargetWindow" PreviewMouseLeftButtonDown="SharedBehaviorSurface_PreviewMouseLeftButtonDown" MouseEnter="SharedBehaviorSurface_MouseEnter" MouseLeave="SharedBehaviorSurface_MouseLeave">
                            <Grid>
                            <StackPanel x:Name="TargetWindowContent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Target window" Style="{StaticResource SectionTitle}" />
                                    <CheckBox x:Name="EnableTargetWindowCheckBox" IsChecked="True" Checked="EnableTargetWindowCheckBox_Changed" Unchecked="EnableTargetWindowCheckBox_Changed" ToolTip="Enable target window restriction" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <CheckBox.Template>
                                            <ControlTemplate TargetType="CheckBox">
                                                <Border x:Name="Track" Width="28" Height="16" CornerRadius="8" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                                    <Ellipse x:Name="Thumb" Width="10" Height="10" Fill="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" Margin="2" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="Thumb" Property="Fill" Value="White" />
                                                        <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </CheckBox.Template>
                                    </CheckBox>
                                    <Border Width="18" Height="18" CornerRadius="9" Background="Transparent" BorderBrush="{DynamicResource TextAccentBrush}" BorderThickness="1" Margin="6,-1,0,0" VerticalAlignment="Top" ToolTipService.ShowDuration="30000">
                                        <Border.ToolTip>
                                            <TextBlock Text="Optional: leave this blank for global input to the active window. Enter an executable name to run only while that app is active, or use the search icon to select one visible window." TextWrapping="Wrap" MaxWidth="275" />
                                        </Border.ToolTip>
                                        <TextBlock Text="i" Foreground="{DynamicResource TextAccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TargetExecutableBox" TextChanged="TargetExecutableBox_TextChanged" ToolTip="Executable name, for example notepad.exe" />
                                    <Button Grid.Column="1" Click="FindWindowsButton_Click" Style="{StaticResource GhostButton}" ToolTip="Choose a visible window" Width="30" Height="30" Padding="0" Margin="6,0,0,0">
                                        <Grid Width="14" Height="14">
                                            <Ellipse Width="9" Height="9" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <Line X1="9" Y1="9" X2="14" Y2="14" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="ClearTargetWindowButton" Grid.Column="2" Click="ClearTargetWindowButton_Click" Style="{StaticResource GhostButton}" ToolTip="Clear the selected target window" Width="30" Height="30" Padding="0" Margin="6,0,0,0">
                                        <Viewbox Width="11" Height="11">
                                            <Path Data="M 2 2 L 10 10 M 10 2 L 2 10" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Viewbox>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="TargetWindowHint" Text="Global input enabled." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" ToolTip="Input is sent to whichever window is active." Margin="0,5,0,0" />
                            </StackPanel>
                            <Border x:Name="TargetWindowSharedOverlay" Visibility="Collapsed" Background="{DynamicResource ControlBrush}" Opacity="0.97" CornerRadius="8" IsHitTestVisible="False">
                                <TextBlock x:Name="TargetWindowSharedOverlayLabel" Text="Click to override target window for this hotkey" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18" />
                            </Border>
                            </Grid>
                        </Border>
                        <Border x:Name="LiveArea" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource LiveBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13,10" Margin="0,0,6,0" PreviewMouseDown="LiveArea_PreviewMouseDown">
                            <StackPanel>
                                <TextBlock x:Name="LiveTitleLabel" Text="LIVE CLICK AREA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock x:Name="LiveCountLabel" Text="Start to test" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                <TextBlock x:Name="LiveIntervalLabel" Text="Waiting for clicks" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                <TextBlock x:Name="LiveMouseHint" Text="Hover here while running" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,7,0,0" />
                                <Grid x:Name="LiveKeyFocusBox" Visibility="Collapsed" Margin="0,7,0,0">
                                    <TextBox x:Name="KeyTestBox" IsReadOnly="True" FontSize="10" Padding="8,5" PreviewKeyDown="KeyTestBox_PreviewKeyDown" GotKeyboardFocus="KeyTestBox_GotKeyboardFocus" />
                                    <TextBlock x:Name="KeyTestPlaceholder" Text="Focus here while running" IsHitTestVisible="False" Margin="9,0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,15,15" Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="SimpleFooter" Orientation="Horizontal" Grid.Column="0">
                        <Button x:Name="StartButton" Content="Start" Click="StartButton_Click" Style="{StaticResource PrimaryButton}" Width="86" />
                        <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" Style="{StaticResource DangerButton}" Width="76" Margin="8,0,0,0" IsEnabled="False" />
                        <Button x:Name="SetDefaultButton" Content="Set as default" ToolTip="Save every setting, including the hotkey, as the startup default." Click="SaveDefaultButton_Click" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="StatusLabel" Grid.Column="1" Text="Ready" Margin="12,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}" FontSize="11" />
                </Grid>
            </Border>
            <Border x:Name="AdvancedFooter" Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,15,15" Padding="22,10,22,7" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="PROFILE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <ItemsControl x:Name="RecentProfilesList" Grid.Column="1">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Profile}" Click="RecentProfileButton_Click" ToolTip="{Binding Tooltip}" FontSize="9" Padding="4,3" Width="54" Margin="0,0,3,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Ellipse Grid.Column="1" Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="3,0,0,0" Visibility="{Binding UnsavedIndicatorVisibility}" ToolTip="Unsaved changes"/></Grid><Button.ContextMenu><ContextMenu Opened="ProfileContextMenu_Opened"><MenuItem Header="Configure profile defaults" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="ConfigureProfileDefaults_Click"/><MenuItem Header="Use app defaults" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="UseAppDefaultsForProfile_Click"/><MenuItem x:Name="DiscardProfileChangesMenuItem" Header="Discard changes" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="DiscardProfileChanges_Click"/><MenuItem Header="Choose sections to use app defaults…" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="UseSharedProfileBehaviorDefaults_Click"/><Separator/><MenuItem Header="Configure profile lighting…" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="ConfigureProfileLighting_Click"/><MenuItem Header="Use app lighting defaults" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="UseAppLightingDefaultsForProfile_Click"/><Separator/><MenuItem Header="Export profile…" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="ExportProfile_Click"/><MenuItem Header="Rename profile" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="RenameProfile_Click"/><MenuItem Header="Duplicate profile" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="DuplicateProfile_Click"/><Separator x:Name="DeleteProfileSeparator"/><MenuItem x:Name="DeleteProfileMenuItem" Header="Delete profile" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="DeleteProfile_Click" Style="{StaticResource DangerMenuItem}"/></ContextMenu></Button.ContextMenu></Button></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="NewProfileButton" Grid.Column="2" Click="NewProfileButton_Click" ToolTip="Start a new unsaved profile" Style="{StaticResource RoundFooterIconButton}" Margin="0,0,4,0"><TextBlock Text="+" Margin="0,-1,0,0"/></Button>
                        <Button x:Name="AdvancedSaveProfileButton" Grid.Column="3" Click="SaveProfileButton_Click" ToolTip="Save changes to this profile" Style="{StaticResource GhostButton}" Width="26" Height="24" Padding="0" Margin="0,0,4,0"><Viewbox Width="12" Height="12"><Path Data="M 3 2 L 17 2 L 21 6 L 21 21 L 3 21 Z M 7 2 L 7 8 L 16 8 L 16 2 M 7 21 L 7 13 L 17 13 L 17 21" Stroke="{DynamicResource TextAccentBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox></Button>
                        <Button x:Name="ManageProfilesButton" Grid.Column="4" Content="…" Click="ManageProfilesButton_Click" ToolTip="Profile options" Style="{StaticResource GhostButton}" FontSize="14" Width="26" Height="24" Padding="0" Margin="0,0,6,0"/>
                        <Border Grid.Column="5" Width="1"/>
                        <TextBlock x:Name="AdvancedStatusLabel" Grid.Column="6" Text="Ready" ToolTip="Ready" Margin="9,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SuccessBrush}" FontSize="10"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,3,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="33"/></Grid.ColumnDefinitions>
                        <ItemsControl x:Name="AdvancedActionsFooterList" Grid.Column="0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border x:Name="ActionTile" CornerRadius="6" Margin="0,0,4,3" Padding="5,3" AllowDrop="True" ToolTip="Drag the tile header to reorder hotkeys" PreviewMouseLeftButtonDown="AdvancedActionTile_PreviewMouseLeftButtonDown" MouseMove="AdvancedActionTile_MouseMove" MouseLeftButtonUp="AdvancedActionTile_MouseLeftButtonUp" DragEnter="AdvancedActionTile_DragEnter" DragLeave="AdvancedActionTile_DragLeave" DragOver="AdvancedActionTile_DragOver" Drop="AdvancedActionTile_Drop" MouseRightButtonUp="AdvancedActionHeader_RightClick"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource ControlBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="1.5"/></DataTrigger><DataTrigger Binding="{Binding HotkeyEnabled}" Value="False"><Setter Property="Opacity" Value="0.58"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="15"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Grid.Row="0" Background="{DynamicResource LiveBorderBrush}" CornerRadius="5,5,0,0" Padding="8,0" Margin="-5,-3,-5,0"><Grid><TextBlock Text="{Binding HotkeyLabel}" ToolTip="{Binding HotkeyTooltip}" TextTrimming="CharacterEllipsis" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextAccentBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/><TextBlock Text="{Binding BehaviorBadge}" ToolTip="{Binding BehaviorTooltip}" Visibility="{Binding BehaviorBadgeVisibility}" Foreground="{DynamicResource TextMutedBrush}" FontSize="7" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,1,0,0"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=ActionTile}" Value="True"><Setter Property="Margin" Value="0,1,18,0"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Panel.ZIndex="1" Content="×" Tag="{Binding Action}" Click="AdvancedActionRemove_Click" ToolTip="Remove this hotkey" Width="15" Height="15" MinWidth="0" MinHeight="0" Padding="0,0,0,1" HorizontalAlignment="Right" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEnabled="{Binding CanEdit}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CloseButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=ActionTile}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding RemovalPending}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsMultiSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style><Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" LineHeight="11" TextAlignment="Center" VerticalAlignment="Center"/></DataTemplate></Button.ContentTemplate></Button><StackPanel Panel.ZIndex="1" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding RemovalConfirmationVisibility}"><Button Content="Undo" ContentTemplate="{StaticResource UndoIcon}" Tag="{Binding Action}" Click="CancelAdvancedActionRemove_Click" ToolTip="Keep this hotkey" Style="{StaticResource GhostButton}" Background="Transparent" BorderBrush="Transparent" Width="15" Height="15" MinWidth="0" MinHeight="0" Padding="0"/><Button Tag="{Binding Action}" Click="AdvancedActionRemove_Click" ToolTip="Confirm removal" Style="{StaticResource DangerButton}" Background="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerPaleBrush}" Width="48" Height="15" MinWidth="0" MinHeight="0" Padding="2,0" Margin="2,0,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="Confirm" Foreground="White" FontSize="7" VerticalAlignment="Center"/><Viewbox Width="7" Height="7" Margin="2,0,0,0"><Path Fill="White" Data="M 7 3 L 17 3 L 16 20 L 8 20 Z M 5 3 L 19 3 M 9 1 L 15 1 M 10 7 L 10 16 M 14 7 L 14 16" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox></StackPanel></Button></StackPanel></Grid></Border><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="21"/><ColumnDefinition Width="21"/></Grid.ColumnDefinitions>
                                        <Button Grid.ColumnSpan="{Binding ActionLabelColumnSpan}" Tag="{Binding Action}" Click="AdvancedActionEdit_Click" MouseRightButtonUp="AdvancedActionBody_RightClick" ToolTip="{Binding ActionLabel}" Style="{StaticResource GhostButton}" Background="Transparent" BorderBrush="Transparent" FontSize="9" Padding="0" MinWidth="0" HorizontalContentAlignment="Left" IsEnabled="{Binding CanEdit}"><Button.Content><MultiBinding Converter="{StaticResource AdvancedActionLabelConverter}"><Binding Path="Action"/><Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border}"/><Binding Path="ShowInlineActionControls"/></MultiBinding></Button.Content><Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DataTemplate></Button.ContentTemplate></Button>
                                        <Button Grid.Column="1" Content="▶" Tag="{Binding Action}" Click="AdvancedActionStart_Click" ToolTip="Start this hotkey action" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanStart}" Visibility="{Binding InlineActionControlsVisibility}" Height="20" MinWidth="0" VerticalAlignment="Center" FontSize="9" Padding="0" Margin="1,0,0,0"/>
                                        <Button Grid.Column="2" Content="■" Tag="{Binding Action}" Click="AdvancedActionStop_Click" ToolTip="Stop this hotkey action" Style="{StaticResource DangerButton}" IsEnabled="{Binding CanStop}" Visibility="{Binding InlineActionControlsVisibility}" Height="20" MinWidth="0" VerticalAlignment="Center" FontSize="8" Padding="0" Margin="1,0,0,0"/></Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyAdvancedActionsLabel" Grid.Column="0" Text="No actions yet — use + to add a hotkey." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Button x:Name="AddAdvancedActionButton" Grid.Column="1" Content="+" Click="AddAdvancedAction_Click" ToolTip="Add a hotkey using the current action settings" Style="{StaticResource GhostButton}" FontSize="16" Width="30" Height="30" MinWidth="0" MinHeight="0" Padding="0" Margin="3,0,0,0" VerticalAlignment="Center"><Button.RenderTransform><TranslateTransform Y="-1" /></Button.RenderTransform></Button>
                    </Grid>
                </Grid>
            </Border>
            <Button x:Name="CollapseButton" Grid.Row="2" Panel.ZIndex="2" Click="CollapseButton_Click" ToolTip="Hide settings" Style="{StaticResource CollapseBarButton}" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,-18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl x:Name="CollapseGlyph" Content="." ContentTemplate="{StaticResource CollapseIcon}" Width="13" Height="13" />
                    <TextBlock x:Name="CollapseLabel" Text="Hide settings" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Border x:Name="OpenRgbWarningIndicator" Grid.Row="2" Panel.ZIndex="3" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,14" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="10" Padding="4" ToolTipService.ShowDuration="60000" Cursor="Help">
                <Grid Width="14" Height="14">
                    <Ellipse Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.5" />
                    <TextBlock Text="i" Foreground="{DynamicResource WarningBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
